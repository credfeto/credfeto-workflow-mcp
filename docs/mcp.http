Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 24,
  "method": "tools/call",
  "params": {
    "name": "workflow_status_set",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "pr": 82,
      "status": "Testing"
    }
  }
}
