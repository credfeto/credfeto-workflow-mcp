### Call the issue_create tool with a priority and labels; creates any missing label and the issue, puts it on the Workflow board as Not Started and expects the issue URL
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 35,
  "method": "tools/call",
  "params": {
    "name": "issue_create",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "priority": "medium",
      "title": "docs: try the issue_create tool",
      "body": "## Summary\n\nCreated from docs/mcp.http.",
      "labels": ["enhancement", "Read Me"]
    }
  }
}

### Call the issue_create tool with a priority given as a label; expects the tool error "'high' is a priority; use --priority High, not --label" and creates nothing
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 36,
  "method": "tools/call",
  "params": {
    "name": "issue_create",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "priority": "Medium",
      "title": "docs: try the issue_create tool",
      "body": "Created from docs/mcp.http.",
      "labels": ["high"]
    }
  }
}

### Call the issue_create tool with a title that is not "prefix: text" in a credfeto repository; expects an "invalid value for --title" tool error and creates nothing
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 37,
  "method": "tools/call",
  "params": {
    "name": "issue_create",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "priority": "Low",
      "title": "Try the issue_create tool",
      "body": "Created from docs/mcp.http."
    }
  }
}

### Call the issue_edit tool on an issue, which may have been opened by another account; expects outcome "Edited" with the issue URL, or "Unchanged" when it already is as asked
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 88,
  "method": "tools/call",
  "params": {
    "name": "issue_edit",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "issue": 47,
      "title": "tool(mcp): add the issue_edit tool",
      "body": "## Summary\n\nEdited from docs/mcp.http.",
      "assignSelf": true
    }
  }
}

### Call the issue_edit tool with a title that is not "prefix: text" in a credfeto repository; expects an "invalid value for --title" tool error and nothing written
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 89,
  "method": "tools/call",
  "params": {
    "name": "issue_edit",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "issue": 47,
      "title": "Add the issue_edit tool"
    }
  }
}

### Call the issue_edit tool with a body holding a token; expects outcome "Refused" with the rule "token" and its line, and nothing written
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 90,
  "method": "tools/call",
  "params": {
    "name": "issue_edit",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "issue": 47,
