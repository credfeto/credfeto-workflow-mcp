@baseUrl = http://127.0.0.1:8080
# A GitHub token; the server forwards it to GitHub and never validates or stores it.
@token = replace-with-a-github-token

# The MCP endpoint is stateless: each request stands alone, with no session header.
# Streamable HTTP requires both JSON and event-stream in Accept, otherwise the server replies 406.
# Every request must carry "Authorization: Bearer <token>", otherwise the server replies 401.

### Missing Authorization header; expects 401 with "WWW-Authenticate: Bearer"
POST {{baseUrl}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 0,
  "method": "tools/list",
  "params": {}
}

### Initialize
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2025-06-18",
    "capabilities": {},
    "clientInfo": {
      "name": "http-client",
      "version": "1.0.0"
    }
  }
}

### List tools; expects the "branch_required_checks", "issue_comments", "issue_view", "ping", "pr_checks", "pr_comments", "pr_view", "workflow_status_check" and "workflow_status_set" tools
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}

### Call the ping tool; expects {"value":"pong"}
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "ping",
    "arguments": {}
  }
}

### Call the pr_comments tool; expects the pull request's comments, reviews, review threads and summary
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 4,
  "method": "tools/call",
  "params": {
    "name": "pr_comments",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "pr": 41
    }
  }
}

### Call the pr_comments tool with an invalid repository; expects a tool error naming the "repo" parameter
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 5,
  "method": "tools/call",
  "params": {
    "name": "pr_comments",
    "arguments": {
      "repo": "not-a-repository",
      "pr": 41
    }
  }
}

### Call the branch_required_checks tool; expects the repository, the branch and its required check names
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 6,
  "method": "tools/call",
  "params": {
    "name": "branch_required_checks",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "branch": "main"
    }
  }
}

### Call the branch_required_checks tool with an invalid branch; expects a tool error naming the "branch" parameter
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 7,
  "method": "tools/call",
  "params": {
    "name": "branch_required_checks",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "branch": "-bad"
    }
  }
}

### Call the pr_view tool with no fields; expects every field except files and body, in canonical order
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 8,
  "method": "tools/call",
  "params": {
    "name": "pr_view",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "pr": 41
    }
  }
}

### Call the pr_view tool with a subset of fields; expects only the state, title and head-sha fields
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 9,
  "method": "tools/call",
  "params": {
    "name": "pr_view",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "pr": 41,
      "fields": ["title", "head-sha", "state"]
    }
  }
}

### Call the pr_view tool for files on their own; expects every changed file path, or a tool error if the list is incomplete
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 10,
  "method": "tools/call",
  "params": {
    "name": "pr_view",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "pr": 41,
      "fields": ["files"]
    }
  }
}

### Call the pr_view tool with body and another field; expects a tool error naming the "fields" parameter
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 11,
  "method": "tools/call",
  "params": {
    "name": "pr_view",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "pr": 41,
      "fields": ["body", "title"]
    }
  }
}

### Call the pr_view tool with pull request 0; expects a tool error naming the "pullRequest" parameter
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 12,
  "method": "tools/call",
  "params": {
    "name": "pr_view",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "pr": 0
    }
  }
}

### Call the issue_view tool; expects the issue's title, state, labels, assignees and body
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 13,
  "method": "tools/call",
  "params": {
    "name": "issue_view",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "issue": 16
    }
  }
}

### Call the issue_view tool with a pull request number; expects a tool error saying the issue was not found
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 14,
  "method": "tools/call",
  "params": {
    "name": "issue_view",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "issue": 41
    }
  }
}

### Call the issue_view tool with issue 0; expects a tool error naming the "issue" parameter
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 15,
  "method": "tools/call",
  "params": {
    "name": "issue_view",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "issue": 0
