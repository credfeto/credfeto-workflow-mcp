### Call the pr_list tool with every filter; expects only the open pull requests from that head branch that link the issue and carry every label, in any case
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 29,
  "method": "tools/call",
  "params": {
    "name": "pr_list",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "issue": 61,
      "head": "feat/61-mcp-pr-list-label-filter",
      "labels": ["Type: Feature"]
    }
  }
}

