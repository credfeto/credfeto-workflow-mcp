### Call the issue_comments tool; expects the comments oldest first and a summary of counts
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 25,
  "method": "tools/call",
  "params": {
    "name": "issue_comments",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "issue": 58
    }
  }
}

### Call the issue_comments tool for a pull request with since and author filters; expects only that author's comments created at or after the time
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 26,
  "method": "tools/call",
  "params": {
    "name": "issue_comments",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "issue": 83,
      "since": "2026-01-01T00:00:00Z",
      "author": "credfeto"
    }
  }
}

### Call the issue_comments tool with an invalid since; expects a tool error naming the "since" parameter
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 27,
  "method": "tools/call",
  "params": {
    "name": "issue_comments",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "issue": 58,
      "since": "2026-01-01"
    }
  }
}

### Call the workflow_status_check tool for a pull request; expects outcome "Found" and its Workflow board status, "Unset", or "NotOnBoard" with a message
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 16,
  "method": "tools/call",
  "params": {
    "name": "workflow_status_check",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "pr": 81
    }
  }
}

### Call the workflow_status_check tool for an issue; expects outcome "Found" and its Workflow board status, "Unset", or "NotOnBoard" with a message
POST {{baseUrl}}/mcp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 17,
  "method": "tools/call",
  "params": {
    "name": "workflow_status_check",
    "arguments": {
      "repo": "credfeto/credfeto-workflow-mcp",
      "issue": 13
    }
  }
}

